# Add these in Vercel: Project -> Settings -> Environment Variables
# (Do NOT put real values in GitHub.)

# Any long random text, at least 16 characters. Used to sign login sessions.
AUTH_SECRET=put-a-long-random-text-here

# The password for the owner account (email below). Choose a strong one.
OWNER_PASSWORD=choose-a-strong-password

# Optional. Defaults to satheeshsai73@gmail.com
OWNER_EMAIL=satheeshsai73@gmail.com

# The database variables (KV_REST_API_URL and KV_REST_API_TOKEN) are added
# automatically when you connect the Upstash Redis database to the project.
